  "pool": "zz1000",
  "exclude_st": true,
  "holding_num": 20,
  "rebalance_interval": 15,
  "backtest": {
    "start": "2025-04-12",
    "end": "2026-04-12",
    "benchmark": "zz1000",
    "trade_cost": 0.002
  },
  "objective": {
    "weights": {
      "calmar": 0.55,
      "sortino": 0.25,
      "information_ratio": 0.20
    },
    "hard_constraints": {
      "max_drawdown_limit": 0.35
