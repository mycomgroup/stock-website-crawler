    {
      "factor": "pe_ttm",
      "ascending": true,
      "weight": 0.3,
      "description": "兼顾市盈率低的股票"
    },
    {
      "factor": "roe",
      "ascending": false,
      "weight": 0.3,
      "description": "优先选择盈利能力强的股票"
    }
