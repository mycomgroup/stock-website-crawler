# Google Gemini API Configuration

# Google Account (for login)
GOOGLE_EMAIL=your-email@gmail.com

# Optional: Chrome profile path (if you want to use existing login)
# CHROME_PROFILE_PATH=/Users/username/Library/Application Support/Google/Chrome/Default

# Optional: Headless mode (set to false to see browser)
HEADLESS=true

# Optional: Default model
DEFAULT_MODEL=gemini-pro
