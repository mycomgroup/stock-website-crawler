{
  "name": "低估值高股息初始策略",
  "description": "沪深300低估值高股息策略，筛选低PE、低PB、高股息率股票，追求稳健收益",
  "template": "single_period",
  "universe": ["000300.XSHG"],
  "industries": ["*"],
  "board": ["*"],
  "stOption": "exclude",
  "filters": [
    {
      "operator": "less_than",
      "factor": {"type": "fundamental", "name": "pe_ratio"},
      "rhs": 30
    }
  ],
  "sorting": [
    {
      "factor": {"type": "fundamental", "name": "dividend_yield"},
      "ascending": false,
      "weight": 0.6
    },
    {
      "factor": {"type": "fundamental", "name": "pe_ratio"},
      "ascending": true,
      "weight": 0.4
    }
  ],
  "maxHoldingNum": 15,
  "rebalanceInterval": 10,
  "backtest": {
    "start_date": "AUTO",
    "end_date": "AUTO",
    "capital": "100000",
    "benchmark": "000300.XSHG"
  },
  "objective": {
    "weights": {"calmar": 0.55, "sortino": 0.25, "information_ratio": 0.20},
    "hard_constraints": {"max_drawdown_limit": 0.35}
  },
  "loop": {
    "max_iterations": 100,
    "max_consecutive_failures": 5,
    "max_wait_seconds": 600
  }
}
